rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isTeacher() { return signedIn() && request.auth.token.teacher == true; }
    function ownsClass(classId) {
      return isTeacher() && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }
    function isActiveMember(classId) {
      return signedIn() &&
        get(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)).data.status == 'active';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','teacher','admin','disabled']);
      allow delete: if false;
    }

    match /classes/{classId} {
      allow read: if ownsClass(classId) || isActiveMember(classId) || isAdmin();
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if ownsClass(classId) && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if false;

      match /members/{uid} {
        allow read: if ownsClass(classId) || (signedIn() && request.auth.uid == uid) || isAdmin();
        allow write: if false; // Functions only
      }
    }

    match /questionPublic/{questionId} {
      allow read: if signedIn() && resource.data.contentStatus == 'published';
      allow write: if false; // Admin import only
    }

    match /privateAnswerKeys/{questionId} {
      allow read, write: if false; // Admin SDK only
    }

    match /invites/{inviteId} {
      allow read, write: if false; // Functions only
    }

    match /assignments/{assignmentId} {
      allow read: if signedIn() && (
        resource.data.teacherId == request.auth.uid ||
        isActiveMember(resource.data.classId) || isAdmin()
      );
      allow write: if false; // publish/update via Functions in MVP
    }

    match /attempts/{attemptId} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid || isAdmin()
      );
      allow write: if false; // safest MVP: Functions only

      match /answers/{questionId} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/attempts/$(attemptId)).data.studentId == request.auth.uid ||
          get(/databases/$(database)/documents/attempts/$(attemptId)).data.teacherId == request.auth.uid || isAdmin()
        );
        allow write: if false;
      }
    }

    match /auditLogs/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
